openspec/.vector-search.db*
.claude/scheduled_tasks.lock

# idd-all-chain per-session traversal state — session_id-bearing, ephemeral, not a
# durable artifact (#152). Sibling .claude/.idd/attachments/ deliberately STAYS tracked
# (its manifest is committed), so ignore state/ specifically, not the parent.
.claude/.idd/state/

# IDD tree-lock (idd-tree-lock.sh #183) — per-machine session state, not tracked
.claude/.idd/tree-lock

# wiki 同步標記（0-byte 時間戳）與 impeccable 的 hook cache — 皆為 per-machine
# ephemera，與上面的 tree-lock / state/ 同類：可重新產生、不是 durable artifact。
.wiki-last-sync
**/.impeccable/
